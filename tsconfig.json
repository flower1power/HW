{
  "compilerOptions": {
    "allowJs": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "@playwright/test"]
  },
  "include": ["*.ts", "*.mts", "*.cts", "*.js", "*.mjs", "support/**/*.ts", "tests/**/*.ts"]
}
